<Window x:Class="OotMapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OotMapper"
        mc:Ignorable="d"
        x:Name="_mainWindow" Title="Ocarina Entrance Mapper" Height="600" Width="800"
        Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" BorderBrush="DimGray" BorderThickness="2" Margin="5,5,5,0">
            <Canvas x:Name="_canvas" ClipToBounds="True" Background="PapayaWhip"
                    MouseWheel="Canvas_MouseWheel" MouseDown="Canvas_Click"  MouseMove="Canvas_Move"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="1">
            <ComboBox x:Name="_segmentSelector" Width="350" Margin="5"/>
            <Button Content="Add" Width="35" Margin="5" Click="Add_Click"/>
            <Button Content="Clear" Width="60" Background="OrangeRed" Margin="50,5,5,5" Click="Clear_Click"/>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1">
            <Button x:Name="_saveBasemapBtn" Content="Save Basemap" Background="MediumPurple" Width="110" Margin="5" Click="SaveBasemap"/>
            <Button x:Name="_loadBasemapBtn" Content="Load Basemap" Background="MediumPurple"  Width="110" Margin="5" Click="LoadBasemap"/>
            <Button Content="Save" Width="50" Margin="5" Click="Save_Click"/>
            <Button Content="Load" Width="50" Margin="5" Click="Load_Click"/>
        </StackPanel>
    </Grid>
</Window>
